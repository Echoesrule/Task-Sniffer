# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/work_bot_hunter
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/work_bot_hunter

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Services (optional - for Phase 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security
CV_STORAGE_PATH=/data/cvs
ENCRYPTION_KEY=change-me-32-byte-encryption-key

# Scraping
SCRAPE_INTERVAL_MINUTES=60
MAX_JOBS_PER_SOURCE=100
REQUEST_DELAY_SECONDS=2

# Application
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
