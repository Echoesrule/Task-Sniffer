# Local development defaults. For Docker Compose replace the database URLs
# with PostgreSQL URLs using host `db` and set unique PostgreSQL/Redis secrets.
POSTGRES_USER=task_sniffer
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=
POSTGRES_DB=work_bot_hunter
DATABASE_URL=sqlite+aiosqlite:///./work_bot_hunter.db
DATABASE_URL_SYNC=sqlite:///./work_bot_hunter.db

# Redis. Compose requires authentication and does not publish the port.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(32))'
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Authentication
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Production startup rejects empty, placeholder, low-entropy, or .env-only keys.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12

# Browser session. The frontend uses HttpOnly cookies plus a double-submit CSRF
# token. Set COOKIE_SECURE=true behind HTTPS; use SameSite=None only when the
# frontend and API are on different sites (requires HTTPS).
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Authentication throttling (Redis-backed across API workers in production).
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT_ATTEMPTS=5
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600

# AI Services (optional - for Phase 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security
CV_STORAGE_PATH=/data/cvs
# Provision outside source control: python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
# Back this key up separately: losing it makes encrypted CVs unrecoverable.
ENCRYPTION_KEY=

# Scraping
SCRAPE_INTERVAL_MINUTES=60
MAX_JOBS_PER_SOURCE=100
REQUEST_DELAY_SECONDS=2

# Optional job-board ATS sources. Supply known public employer board IDs only.
# Registration does not enable them; both the IDs and explicit true flag are
# required before the scheduled source runner may ingest them.
GREENHOUSE_ENABLED=false
GREENHOUSE_BOARD_TOKENS=
ASHBY_ENABLED=false
ASHBY_BOARD_NAMES=

# Workable public account jobs endpoint (not SPI credentials). The adapter is
# present for fixture-backed testing but remains REVIEW/disabled until
# third-party display and redistribution terms are approved.
WORKABLE_ACCOUNT_SUBDOMAINS=

# Application
APP_ENV=development
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram chat IDs allowed to run global /stats and /sources.
# Regular users can still link and manage their own applications.
TELEGRAM_ADMIN_CHAT_IDS=
