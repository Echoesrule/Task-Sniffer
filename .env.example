# Local development defaults. For Docker Compose replace the database URLs
# with PostgreSQL URLs using host `db` and set a unique PostgreSQL password.
POSTGRES_USER=task_sniffer
POSTGRES_PASSWORD=
POSTGRES_DB=work_bot_hunter
DATABASE_URL=sqlite+aiosqlite:///./work_bot_hunter.db
DATABASE_URL_SYNC=sqlite:///./work_bot_hunter.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Services (optional - for Phase 4)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Security
CV_STORAGE_PATH=/data/cvs
# Provision outside source control: python -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
ENCRYPTION_KEY=

# Scraping
SCRAPE_INTERVAL_MINUTES=60
MAX_JOBS_PER_SOURCE=100
REQUEST_DELAY_SECONDS=2

# Application
APP_ENV=development
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
