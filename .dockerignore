.git/
.gitignore

# Secrets / local env
.env
.env.*
*.pem

# Virtualenvs
.venv/
venv/
__pycache__/
*.pyc
*.pyo

# Local databases / data
*.db
*.db-journal
*.db-wal
data/

# Logs / runtime state
*.log
*.pid

# Tests & tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
tests/

# Frontend build artifacts
frontend/node_modules/
frontend/.next/
frontend/out/
node_modules/
